        Tween(MainFrame, {Size = UDim2.new(0, 350, 0, 275)}, 0.25)
    end)

    local TabBar = Instance.new("Frame")
    TabBar.Name = "TabBar"
    TabBar.Size = UDim2.new(0, 90, 1, -40)
    TabBar.Position = UDim2.new(0, 5, 0, 40)
    TabBar.BackgroundTransparency = 1
