local function FindKills()
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if not leaderstats then return nil end

    local possibleNames = {"Kills", "Kill", "KOs", "KO", "Eliminations", "Elims"}
    for _, Name in ipairs(possibleNames) do
        local Stat = leaderstats:FindFirstChild(Name)
        if Stat and (Stat:IsA("IntValue") or Stat:IsA("NumberValue")) then
            return Stat
        end
    end
    return nil
end

task.spawn(function()
    local KillStat
    repeat
        task.wait(1)
        KillStat = FindKills()
    until KillStat

    local LastKills = KillStat.Value
    KillStat:GetPropertyChangedSignal("Value"):Connect(function()
        local NewKills = KillStat.Value
        if NewKills > LastKills then
            for _ = LastKills + 1, NewKills do
                PlayKillSound()
            end
        end
        LastKills = NewKills
    end)
end)
