local function getClosestPlayerCamlock()
    local Target = nil
    local Dist = math.huge
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild(CamlockSettings.TargetPart) then
            local hum = v.Character:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                local Pos, OnScreen = Camera:WorldToScreenPoint(v.Character[CamlockSettings.TargetPart].Position)
                if OnScreen then
                    local TargetScreenPos = Vector2.new(Pos.X, Pos.Y)
                    local InputScreenPos = UserInputService.TouchEnabled and (Camera.ViewportSize / 2) or Vector2.new(Mouse.X, Mouse.Y)
                    local Mag = (InputScreenPos - TargetScreenPos).Magnitude
                    if Mag < Dist then
                        Dist = Mag
                        Target = v.Character[CamlockSettings.TargetPart]
                    end
                end
            end
        end
    end
    return Target
end

local function toggleCamlock(btn)
    CamlockEnabled = not CamlockEnabled
    
    if CamlockEnabled then
        LockedTarget = getClosestPlayerCamlock()
        if LockedTarget then
            if btn then
                btn.Text = "Camlock: ON (" .. LockedTarget.Parent.Name .. ")"
                btn.TextColor3 = Color3.fromRGB(100, 255, 100)
                btn.BackgroundColor3 = Color3.fromRGB(50, 90, 50)
            end
            
            ReticleContainer.Visible = true
            ReticleContainer.Size = UDim2.new(0, 80, 0, 80)
            TweenService:Create(ReticleContainer, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 60, 0, 60)
            }):Play()
            
            CamlockConnection = RunService.RenderStepped:Connect(function(deltaTime)
                if LockedTarget and LockedTarget.Parent and LockedTarget.Parent:FindFirstChild("Humanoid") and LockedTarget.Parent.Humanoid.Health > 0 then
                    local TargetPos = LockedTarget.Position
                    local LookAt = CFrame.new(Camera.CFrame.Position, TargetPos)
                    local SmoothFactor = 1 - math.exp(-CamlockSettings.TrackingSpeed * deltaTime)
                    Camera.CFrame = Camera.CFrame:Lerp(LookAt, SmoothFactor)
                    
                    local ScreenPos, OnScreen = Camera:WorldToScreenPoint(TargetPos)
                    if OnScreen then
                        ReticleContainer.Visible = true
                        ReticleContainer.Position = UDim2.new(0, ScreenPos.X, 0, ScreenPos.Y)
                    else
                        ReticleContainer.Visible = false
                    end
                else
                    CamlockEnabled = false
                    ReticleContainer.Visible = false
                    if btn then
                        btn.Text = "Camlock: OFF"
                        btn.TextColor3 = Color3.fromRGB(255, 100, 100)
                        btn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
                    end
                    if CamlockConnection then CamlockConnection:Disconnect() end
                end
            end)
        else
            CamlockEnabled = false
            ReticleContainer.Visible = false
            if btn then
                btn.Text = "Camlock: NO TARGET"
                task.delay(1, function()
                    if not CamlockEnabled then
                        btn.Text = "Camlock: OFF"
                        btn.TextColor3 = Color3.fromRGB(255, 100, 100)
                        btn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
                    end
                end)
            end
        end
    else
        if btn then
            btn.Text = "Camlock: OFF"
            btn.TextColor3 = Color3.fromRGB(255, 100, 100)
            btn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
        end
        ReticleContainer.Visible = false
        if CamlockConnection then CamlockConnection:Disconnect() end
        LockedTarget = nil
    end
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == CamlockSettings.ToggleKey then
        toggleCamlock(nil)
    end
end)

