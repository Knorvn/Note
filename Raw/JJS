local function StartAntiStun()
    if AntiStunConnection then AntiStunConnection:Disconnect() end
    AntiStunConnection = RunService.Stepped:Connect(function()
        if not AntiStunEnabled then return end
        local character = GetCharacter()
        local humanoid = GetHumanoid()
        if character and humanoid then
            pcall(function()
                if character:FindFirstChild("Stun") then
                    character.Stun:Destroy()
                end
                humanoid.PlatformStand = false
                humanoid.Sit = false
                if humanoid.WalkSpeed < 16 then
                    humanoid.WalkSpeed = 16
                end
            end)
        end
    end)
end

local function GetNearestTarget(maxRange)
    local Root = GetRoot()
    if not Root then return nil end

    local nearestTarget = nil
    local shortestDistance = maxRange

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            local rootPart = char and char:FindFirstChild("HumanoidRootPart")
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
            if rootPart and humanoid and humanoid.Health > 0 then
                local dist = (rootPart.Position - Root.Position).Magnitude
                if dist <= shortestDistance then
                    shortestDistance = dist
                    nearestTarget = rootPart
                end
            end
        end
    end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
            local isPlayer = Players:GetPlayerFromCharacter(obj)
            if not isPlayer and obj.Humanoid.Health > 0 then
                local rootPart = obj.HumanoidRootPart
                local dist = (rootPart.Position - Root.Position).Magnitude
                if dist <= shortestDistance then
                    shortestDistance = dist
                    nearestTarget = rootPart
                end
            end
        end
    end

    return nearestTarget
end

local function StartAutoAim()
    if AutoAimConnection then AutoAimConnection:Disconnect() end
    AutoAimConnection = RunService.RenderStepped:Connect(function()
        if not AutoAimEnabled then return end
        local Root = GetRoot()
        if not Root then return end

        local target = GetNearestTarget(SlientRange)
        if target then
            local pos = Root.Position
            local targetPos = Vector3.new(target.Position.X, pos.Y, target.Position.Z)
            Root.CFrame = CFrame.lookAt(pos, targetPos)
        end
    end)
end

