local function GetCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function GetRoot()
    local Character = GetCharacter()
    return Character and Character:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid()
    local Character = GetCharacter()
    return Character and Character:FindFirstChildOfClass("Humanoid")
end

local function isAliveModel(model, exceptChar)
    if model == exceptChar then return false end
    local root = model:FindFirstChild("HumanoidRootPart")
    local humanoid = model:FindFirstChild("Humanoid")
    return root and humanoid and humanoid.Health > 0
end

local function getDivergentFistRemote()
    local ok, remote = pcall(function()
        return ReplicatedStorage
            :WaitForChild("Knit", 5)
            :WaitForChild("Knit", 5)
            :WaitForChild("Services", 5)
            :WaitForChild("DivergentFistService", 5)
            :WaitForChild("RE", 5)
            :WaitForChild("Activated", 5)
    end)
    return ok and remote or nil
end

local targetRemote = getDivergentFistRemote()

local function findNearestTargetBF()
    local hrp = GetRoot()
    if not hrp then return nil end

    local myChar = LocalPlayer.Character
    local nearest = nil
    local bestDist = math.huge

    local function checkModel(model)
        if not isAliveModel(model, myChar) then return end
        local root = model:FindFirstChild("HumanoidRootPart")
        local dist = (hrp.Position - root.Position).Magnitude
        if dist < bestDist then
            bestDist = dist
            nearest = model
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            checkModel(player.Character)
        end
    end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            checkModel(obj)
        end
    end

    return nearest
end

local function curvedDashBehind(targetRoot, duration, customOffset)
    local char = LocalPlayer.Character
    if not char then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")

    if not hrp or not hum or not targetRoot then return end

    hum.AutoRotate = false

    local startTime = tick()
    local startPos = hrp.Position 
    local offsetDistance = customOffset or CONFIG_BF.BehindOffset

    local conn
    conn = RunService.RenderStepped:Connect(function()
        if not targetRoot or not targetRoot.Parent then
            hum.AutoRotate = true
            conn:Disconnect()
            return
        end

        local elapsed = tick() - startTime
        local alpha = math.clamp(elapsed / duration, 0, 1)

        if alpha >= 1 then
            hum.AutoRotate = true
            conn:Disconnect()
            return
        end

        local smoothAlpha = 1 - (1 - alpha)^3
        local enemyCF = targetRoot.CFrame
        local enemyPos = enemyCF.Position
        
        local behindPos = enemyPos - (enemyCF.LookVector * offsetDistance)
        local basePos = startPos:Lerp(behindPos, smoothAlpha)
        local curve = enemyCF.RightVector * math.sin(smoothAlpha * math.pi) * offsetDistance
        local finalPos = basePos + curve

        hrp.CFrame = CFrame.lookAt(finalPos, enemyPos)
    end)
end

if targetRemote then
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        if getnamecallmethod() ~= "FireServer" or self ~= targetRemote then
            return oldNamecall(self, ...)
        end

        if not BlackFlashEnabled or isCoolingBF then 
            return oldNamecall(self, ...)
        end

        isCoolingBF = true

        local args = {...}
        local result = oldNamecall(self, ...)

        task.delay(CONFIG_BF.FireDelay, function()
            pcall(function()
                targetRemote:FireServer(table.unpack(args))
            end)
            isCoolingBF = false
        end)

        task.delay(CONFIG_BF.WarpDelay, function()
            local target = findNearestTargetBF()
            if not target then return end
            local targetRoot = target:FindFirstChild("HumanoidRootPart")
            if not targetRoot then return end

            local myHrp = GetRoot()
            local chosenOffset = CONFIG_BF.BehindOffset

            if myHrp then
                local enemyLook = targetRoot.CFrame.LookVector
                local myLook = myHrp.CFrame.LookVector
                local dotProduct = enemyLook:Dot(myLook)
                
                if dotProduct > 0.5 then return end

                if math.abs(dotProduct) <= 0.5 then
                    chosenOffset = CONFIG_BF.BehindOffset * 0.5
                end
            end

            curvedDashBehind(targetRoot, CONFIG_BF.FireDelay, chosenOffset)
        end)

        return result
    end)
end

