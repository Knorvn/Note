local SliderFrame = Instance.new("Frame")
SliderFrame.Size = UDim2.new(1, 0, 0, 8)
SliderFrame.Position = UDim2.new(0, 0, 0, 14)
SliderFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
SliderFrame.BorderColor3 = Color3.fromRGB(10, 10, 10)
SliderFrame.Parent = SliderContainer

local SliderFill = Instance.new("Frame")
SliderFill.Size = UDim2.new((SlientRange - 10) / (100 - 10), 0, 1, 0)
SliderFill.BackgroundColor3 = Color3.fromRGB(0, 132, 255)
SliderFill.BorderSizePixel = 0
SliderFill.Parent = SliderFrame

local Sliding = false
local function UpdateRangeSlider(input)
    local pos = math.clamp((input.Position.X - SliderFrame.AbsolutePosition.X) / SliderFrame.AbsoluteSize.X, 0, 1)
    SlientRange = math.floor(10 + (pos * (100 - 10)))
    SliderFill.Size = UDim2.new(pos, 0, 1, 0)
    RangeLabel.Text = "Slient Range: " .. tostring(SlientRange) .. " studs"
end

SliderFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        Sliding = true
        UpdateRangeSlider(input)
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        Sliding = false
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if Sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        UpdateRangeSlider(input)
    end
end)

