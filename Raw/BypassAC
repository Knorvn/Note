sweepBtn.MouseButton1Click:Connect(function()
	isSweep = not isSweep
	if isSweep then
		sweepBtn.Text = "Sweep all : ON"
		sweepBtn.TextColor3 = Color3.fromRGB(100, 255, 100)
		sweepTask = task.spawn(function()
			local lastTarget = nil
			while isSweep do
				local targets = {}
				for _, p in pairs(Players:GetPlayers()) do
					if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
						table.insert(targets, p.Character.HumanoidRootPart)
					end
				end
				for _, obj in pairs(Workspace:GetDescendants()) do
					if obj:IsA("Model") and obj ~= player.Character and (obj:FindFirstChildOfClass("Humanoid") or obj:FindFirstChild("HumanoidRootPart")) then
						local hrp = obj:FindFirstChild("HumanoidRootPart")
						if hrp then
							table.insert(targets, hrp)
						end
					end
				end
				
				if #targets > 0 then
					local validTargets = {}
					for _, t in pairs(targets) do
						if t ~= lastTarget then
							table.insert(validTargets, t)
						end
					end
					if #validTargets == 0 then validTargets = targets end
					
					local chosenTarget = validTargets[math.random(1, #validTargets)]
					lastTarget = chosenTarget
					
					local character = player.Character
					if character and character:FindFirstChild("HumanoidRootPart") then
						if controlPart then
							controlPart.CFrame = chosenTarget.CFrame + Vector3.new(0, 3, 0)
						else
							character.HumanoidRootPart.CFrame = chosenTarget.CFrame + Vector3.new(0, 3, 0)
						end
					end
				end
				task.wait(0.03)
			end
		end)
	else
		sweepBtn.Text = "Sweep all : OFF"
		sweepBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
		if sweepTask then
			task.cancel(sweepTask)
			sweepTask = nil
		end
	end
end)

local function toggleInvisible()
	isEnabled = not isEnabled
	
	local character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then return end
	local rootPart = character.HumanoidRootPart
	local humanoid = character:FindFirstChildOfClass("Humanoid")

	if isEnabled then
		toggleBtn.Text = "Invisible : ON"
		toggleBtn.TextColor3 = Color3.fromRGB(100, 255, 100)

		controlPart = Instance.new("Part")
		controlPart.Name = "InvisibleControlPart"
		controlPart.Size = Vector3.new(2, 5, 2)
		controlPart.CFrame = rootPart.CFrame
		controlPart.CanCollide = false
		controlPart.Anchored = false
		controlPart.Material = Enum.Material.SmoothPlastic
		controlPart.Transparency = 0.5
		controlPart.Color = Color3.fromRGB(233, 233, 233)
		controlPart.Parent = Workspace

		local bodyGyro = Instance.new("BodyGyro")
		bodyGyro.MaxTorque = Vector3.new(1e5, 0, 1e5)
		bodyGyro.CFrame = controlPart.CFrame
		bodyGyro.Parent = controlPart

		bodyVelocity = Instance.new("BodyVelocity")
		bodyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)
		bodyVelocity.Velocity = Vector3.zero
		bodyVelocity.Parent = controlPart

		camera.CameraSubject = controlPart

		jumpConnection = humanoid.Jumping:Connect(function(isJumping)
			if isJumping and controlPart then
				controlPart.AssemblyLinearVelocity = Vector3.new(controlPart.AssemblyLinearVelocity.X, 50, controlPart.AssemblyLinearVelocity.Z)
			end
		end)

		renderConnection = RunService.RenderStepped:Connect(function()
			if not character or not rootPart or not controlPart or not humanoid then return end

			if isNoclip then
				controlPart.CanCollide = false
				rootPart.CanCollide = false
			else
				controlPart.CanCollide = true
				rootPart.CanCollide = true
			end

			local moveDir = humanoid.MoveDirection
			if moveDir.Magnitude > 0 then
				bodyVelocity.Velocity = Vector3.new(moveDir.X * moveSpeed, controlPart.AssemblyLinearVelocity.Y, moveDir.Z * moveSpeed)
			else
				bodyVelocity.Velocity = Vector3.new(0, controlPart.AssemblyLinearVelocity.Y, 0)
			end

			rootPart.AssemblyLinearVelocity = controlPart.AssemblyLinearVelocity
			rootPart.CFrame = CFrame.new(controlPart.Position - Vector3.new(0, depthDistance, 0)) * CFrame.Angles(math.rad(90), 0, 0)
		end)

	else
		toggleBtn.Text = "Invisible : OFF"
		toggleBtn.TextColor3 = Color3.fromRGB(255, 100, 100)

		if renderConnection then renderConnection:Disconnect() renderConnection = nil end
		if jumpConnection then jumpConnection:Disconnect() jumpConnection = nil end

		for _, part in pairs(character:GetDescendants()) do
			if part:IsA("BasePart") then part.CanCollide = true end
		end

		if humanoid then camera.CameraSubject = humanoid end
		if controlPart then controlPart:Destroy() controlPart = nil end
		
		rootPart.CFrame = CFrame.new(rootPart.Position + Vector3.new(0, depthDistance, 0))
	end
end

toggleBtn.MouseButton1Click:Connect(toggleInvisible)
