	else
		minimizeBtn.Text = "-"
		mainFrame.Size = UDim2.new(0, 260, 0, 135)
		for _, child in pairs(contentContainer:GetChildren()) do if child:IsA("GuiObject") then child.Visible = true end end
	end
end)

