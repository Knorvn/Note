    Item = false,
    All = false
}

local function applyHighlight(target, name, color)
    if not target then return end
    local hl = target:FindFirstChild(name)
    if not hl then
        hl = Instance.new("Highlight")
        hl.Name = name
        hl.FillTransparency = 1
        hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = target
    end
    hl.OutlineColor = color
end

local function removeHighlight(target, name)
    if target then
        local hl = target:FindFirstChild(name)
        if hl then hl:Destroy() end
    end
end

local function isKiller(player)
    if player.Team and (player.Team.Name:lower():find("killer") or player.Team.Name:lower():find("monster")) then
        return true
    end
    if player.Character and (player.Character:GetAttribute("IsKiller") or player.Character:FindFirstChild("KillerTag")) then
        return true
    end
    return false
end

