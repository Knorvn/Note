            if espFlags.All then
                applyHighlight(char, "ForsakenESP_Player", Color3.fromRGB(255, 255, 255))
            elseif espFlags.Killer and killerStatus then
                applyHighlight(char, "ForsakenESP_Player", Color3.fromRGB(255, 0, 0))
            elseif espFlags.Survivor and not killerStatus then
                applyHighlight(char, "ForsakenESP_Player", Color3.fromRGB(0, 255, 0))
            else
                removeHighlight(char, "ForsakenESP_Player")
            end
        end
    end

    local itemFolder = workspace:FindFirstChild("Items") or workspace:FindFirstChild("Map") or workspace
    for _, obj in ipairs(itemFolder:GetDescendants()) do
        if obj:IsA("Tool") or (obj:IsA("Model") and (obj.Name:lower():find("item") or obj.Name:lower():find("medkit") or obj.Name:lower():find("cola"))) then
            if espFlags.Item then
                applyHighlight(obj, "ForsakenESP_Item", Color3.fromRGB(0, 140, 255))
            else
                removeHighlight(obj, "ForsakenESP_Item")
            end
        end
    end
end)

