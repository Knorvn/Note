        for _, obj in ipairs(workspace:GetDescendants()) do
            disableVFXObj(obj)
        end
        vfxConn = workspace.DescendantAdded:Connect(function(obj)
            task.defer(function()
                disableVFXObj(obj)
            end)
        end)
    else
        if vfxConn then
            vfxConn:Disconnect()
            vfxConn = nil
        end
        for obj, _ in pairs(savedVFX) do
            if obj and obj.Parent then
                pcall(function() obj.Enabled = true end)
            end
        end
        table.clear(savedVFX)
    end
end, 1234567890)

