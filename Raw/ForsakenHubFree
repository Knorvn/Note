-- Character Setup + Auto Re-enable Infinite Stamina on Respawn
local function setupCharacter(char)
    Humanoid = char:WaitForChild("Humanoid")
    HRP = char:WaitForChild("HumanoidRootPart")
    _G.Humanoid = Humanoid
    _G.HumanoidRootPart = HRP

    aiming = false
    shooting = false
    originalWS, originalJP, originalAutoRotate = nil, nil, nil
    stopVoidRushOverride()

    task.defer(function()
        staminaModule = getStaminaModule()
        if infStaminaEnabled then
            applyInfiniteStamina(true)
        end
    end)
end

