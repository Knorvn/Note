local MicsTab = Window:AddTab("Mics", 1234567890)

local ORIGINAL_DASH_SPEED = 60
local voidrushcontrol = false
local isOverrideActive = false
local voidRushConn = nil
local autoGenEnabled = false

local function stopVoidRushOverride()
    if not isOverrideActive then return end
    isOverrideActive = false

    local hum = _G.Humanoid or Humanoid
    if hum then
        pcall(function()
            hum.WalkSpeed = 16
            hum.AutoRotate = true
            hum:Move(Vector3.new(0, 0, 0))
        end)
    end

    if voidRushConn then
        voidRushConn:Disconnect()
        voidRushConn = nil
    end
end

local function startVoidRushOverride()
    if isOverrideActive then return end
    isOverrideActive = true

    voidRushConn = RunService.RenderStepped:Connect(function()
        local hum = _G.Humanoid or Humanoid
        local root = _G.HumanoidRootPart or HRP
        if not hum or not root then return end

        hum.WalkSpeed = ORIGINAL_DASH_SPEED
        hum.AutoRotate = false

        local direction = root.CFrame.LookVector
        local horizontal = Vector3.new(direction.X, 0, direction.Z)
        if horizontal.Magnitude > 0 then
            hum:Move(horizontal.Unit)
        end
    end)
end

