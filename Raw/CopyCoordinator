end)

local screenX, screenY = 0, 0
local currentX, currentY, currentZ = 0, 0, 0

local function UpdateScreenPos()
	local pos = Square.AbsolutePosition
	screenX = math.floor(pos.X)
	screenY = math.floor(pos.Y)
end

Square:GetPropertyChangedSignal("AbsolutePosition"):Connect(UpdateScreenPos)
UpdateScreenPos()

RunService.RenderStepped:Connect(function()
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root then
		currentX = math.floor(root.Position.X)
		currentY = math.floor(root.Position.Y)
		currentZ = math.floor(root.Position.Z)
	end
	CoordLabel.Text = "X : " .. currentX .. " | Y : " .. currentY .. " | Z : " .. currentZ
end)

local function GetFormattedCoord()
	return "X : " .. currentX .. " | Y : " .. currentY .. " | Z : " .. currentZ
end

