--// Team Knor Intro

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")

local player = Players.LocalPlayer
if not player then
    player = Players.PlayerAdded:Wait()
end

local gui = Instance.new("ScreenGui")
gui.Name = "TeamKnorIntro"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.DisplayOrder = 999999

local text = Instance.new("TextLabel")
text.Name = "IntroText"
text.AnchorPoint = Vector2.new(0.5, 0.5)
text.Position = UDim2.fromScale(0.5, 0.5)
text.Size = UDim2.new(0.95, 0, 0, 60)
text.BackgroundTransparency = 1
text.TextColor3 = Color3.new(1, 1, 1)
text.TextStrokeTransparency = 0
text.TextScaled = true
text.Font = Enum.Font.GothamBold
text.Visible = true
text.Parent = gui

-- Hiển thị GUI
local success = pcall(function()
    gui.Parent = player:WaitForChild("PlayerGui", 10)
end)

if not success or not gui.Parent then
    pcall(function()
        gui.Parent = CoreGui
    end)
end

if not gui.Parent then
    warn("Team Knor: Không thể tạo GUI!")
    return
end

local function show(message)
    text.Text = message
    text.TextTransparency = 0
    text.TextStrokeTransparency = 0
end

local function fade()
    local tween = TweenService:Create(
        text,
        TweenInfo.new(1, Enum.EasingStyle.Linear),
        {
            TextTransparency = 1,
            TextStrokeTransparency = 1
        }
    )
    tween:Play()
    tween.Completed:Wait()
end

show("Script made by Team Knor")
task.wait(1)
fade()

task.wait(0.5)
show("Tiktok : Knorviet | YouTube : Knor Actual")
task.wait(1)
fade()

task.wait(1)
show("This script is out Update")
task.wait(1)
fade()

task.wait(0.4)

local latestScript =
    'loadstring(game:HttpGet("https://raw.githubusercontent.com/Knorvn/Note/refs/heads/main/Raw/BlackFlash-Chain.ReadMe.txt"))()'

show("The latest script has been copied!")

if setclipboard then
    pcall(setclipboard, latestScript)
elseif toclipboard then
    pcall(toclipboard, latestScript)
end

task.wait(1)
fade()
gui:Destroy()

task.wait(1)

