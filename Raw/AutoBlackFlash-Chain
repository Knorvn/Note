-- ──────────────────────────────────────────────
-- LIGHTWEIGHT FIX LAG SYSTEM (VFX & BÓNG TỐI) 🚀
-- ──────────────────────────────────────────────
local originalLightingShadows = Lighting.GlobalShadows
local backupVFX = {}

local function isVFX(obj)
    return obj:IsA("ParticleEmitter") 
        or obj:IsA("Trail") 
        or obj:IsA("Smoke") 
        or obj:IsA("Fire") 
        or obj:IsA("Sparkles") 
        or obj:IsA("Beam")
end

local function applyFixLag()
    -- Xóa bóng tối
    Lighting.GlobalShadows = false

    -- Tắt hiệu ứng VFX
    for _, obj in ipairs(game:GetDescendants()) do
        if isVFX(obj) then
            if backupVFX[obj] == nil then
                backupVFX[obj] = obj.Enabled
            end
            obj.Enabled = false
        end
    end
end

local function restoreFixLag()
    -- Trả lại bóng tối nguyên trạng
    Lighting.GlobalShadows = originalLightingShadows

    -- Khôi phục hiệu ứng VFX
    for obj, wasEnabled in pairs(backupVFX) do
        if obj and obj.Parent then
            obj.Enabled = wasEnabled
        end
    end
    table.clear(backupVFX)
end

-- Tự động tắt VFX mới sinh ra khi bật Fix Lag
game.DescendantAdded:Connect(function(obj)
    if CONFIG.FixLag and isVFX(obj) then
        task.defer(function()
            if backupVFX[obj] == nil then
                backupVFX[obj] = obj.Enabled
            end
            obj.Enabled = false
        end)
    end
end)

-- ──────────────────────────────────────────────
-- UTILS
-- ──────────────────────────────────────────────
local function getHRP()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getAnimator()
    local char = LocalPlayer.Character
    if not char then return nil end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return nil end
    return humanoid:FindFirstChildOfClass("Animator")
end

local function isAliveModel(model)
    local myChar = LocalPlayer.Character
    if model == myChar then return false end
    local root = model:FindFirstChild("HumanoidRootPart")
    local humanoid = model:FindFirstChild("Humanoid")
    return root and humanoid and humanoid.Health > 0
end

local function isWithinBoxLimit(pos1, pos2, limit)
    local diff = pos1 - pos2
    return math.abs(diff.X) <= limit 
       and math.abs(diff.Y) <= limit 
       and math.abs(diff.Z) <= limit
end

local function findNearestTarget()
    local hrp = getHRP()
    if not hrp then return nil end

    local nearest = nil
    local bestDist = math.huge

    local function checkModel(model)
        if not isAliveModel(model) then return end
        local root = model:FindFirstChild("HumanoidRootPart")
        local dist = (hrp.Position - root.Position).Magnitude
        if dist < bestDist then
            bestDist = dist
            nearest = model
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            checkModel(player.Character)
        end
    end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            checkModel(obj)
        end
    end

    return nearest
end

-- ──────────────────────────────────────────────
-- TRAIL & ANIMATION
-- ──────────────────────────────────────────────
local function createTrail(rootPart)
    if not CONFIG.EnableTrail then return end
    
    local a0 = Instance.new("Attachment", rootPart)
    local a1 = Instance.new("Attachment", rootPart)
    a1.Position = Vector3.new(0, 2, 0)

    local trail = Instance.new("Trail", rootPart)
    trail.Attachment0 = a0
    trail.Attachment1 = a1
    trail.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
    trail.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.4),
        NumberSequenceKeypoint.new(1, 1),
    })
    trail.Lifetime = CONFIG.TrailLifetime
    trail.MinLength = 0
    trail.FaceCamera = true

    task.delay(CONFIG.TrailLifetime + 0.1, function()
        trail:Destroy()
        a0:Destroy()
        a1:Destroy()
    end)
end

local cachedDashAnim = nil
local function playDashAnimation(duration)
    local animator = getAnimator()
    if not animator then return end

    if not cachedDashAnim then
        cachedDashAnim = Instance.new("Animation")
        cachedDashAnim.AnimationId = CONFIG.DashAnimationId
        cachedDashAnim.Name = "DivergentFistDashAnim"
    end

    local track = animator:LoadAnimation(cachedDashAnim)
    track.Priority = Enum.AnimationPriority.Action
    track:Play()

    task.delay(duration, function()
        if track and track.IsPlaying then
            track:Stop(0.15)
        end
    end)
end

-- ──────────────────────────────────────────────
-- ANIMATION TRACKER LISTENER 🎭
-- ──────────────────────────────────────────────
local processedTracks = {}

local function onAnimationPlayed(track)
    if not track or not track.Animation then return end
    if track.Animation.AnimationId == CONFIG.TargetAnimId then
        if processedTracks[track] then return end
        processedTracks[track] = true

        if CONFIG.AutoCancel then
            task.spawn(function()
                task.wait(0.55)
                local remote = rightActivatedRemote or getItadoriRightActivatedRemote()
                if remote then
                    pcall(function()
                        remote:FireServer()
                    end)
                end
            end)
        end

        if CONFIG.AutoM1Cancel then
            task.spawn(function()
                task.wait(0.7)
                local remote = activatedRemote or getItadoriActivatedRemote()
                if remote then
                    pcall(function()
                        remote:FireServer()
                    end)
                end
            end)
        end

        track.Stopped:Connect(function()
            processedTracks[track] = nil
        end)
    end
end

local function setupAnimListener(character)
    if not character then return end
    local humanoid = character:WaitForChild("Humanoid", 5)
    if not humanoid then return end
    local animator = humanoid:WaitForChild("Animator", 5)
    if not animator then return end

    animator.AnimationPlayed:Connect(onAnimationPlayed)
end

if LocalPlayer.Character then
    setupAnimListener(LocalPlayer.Character)
end

LocalPlayer.CharacterAdded:Connect(function(char)
    setupAnimListener(char)
end)

-- ──────────────────────────────────────────────
-- CURVED DASH
-- ──────────────────────────────────────────────
local function performCurvedDash(targetRoot)
    local hrp = getHRP()
    if not hrp then return end

    local myPos = hrp.Position
    local targetPos = targetRoot.Position

    if not isWithinBoxLimit(myPos, targetPos, CONFIG.MaxDistanceLimit) then
        print("[DivergentFist] Target exceeds maximum distance limit (XYZ) — skip dash")
        return
    end

    local destPos = (targetRoot.CFrame * CFrame.new(0, 0, CONFIG.BehindOffset)).Position

    if (myPos - destPos).Magnitude < CONFIG.AlreadyBehindTolerance then
        return
    end

    local dist = (destPos - myPos).Magnitude
    if dist < 0.5 then return end

    local dir = (destPos - myPos).Unit
    local side = dir:Cross(Vector3.new(0, 1, 0)).Unit
    if math.random(1, 2) == 2 then side = -side end

    local sw = CONFIG.SideWidth
    local segs = CONFIG.ArcSegments

    local arcDef = {
        { 0.10, sw * 0.50 },
        { 0.30, sw * 0.80 },
        { 0.55, sw * 0.70 },
        { 0.75, sw * 0.40 },
        { 1.00, 0 },
    }

    local waypoints = {}
    for i = 1, math.min(segs, #arcDef) do
        local fwd = arcDef[i][1]
        local sw2 = arcDef[i][2]
        table.insert(waypoints, myPos + (dir * dist * fwd) + (side * dist * sw2))
    end

    local totalTime = math.max(dist / CONFIG.DashSpeed, 0.08)
    local segTime = totalTime / #waypoints

    createTrail(hrp)
    playDashAnimation(totalTime)

    for i, wp in ipairs(waypoints) do
        local lookDir = (i < #waypoints) and (waypoints[i + 1] - wp).Unit or (targetRoot.Position - wp).Unit
        local tween = TweenService:Create(
            hrp,
            TweenInfo.new(segTime, Enum.EasingStyle.Linear),
            { CFrame = CFrame.new(wp, wp + lookDir) }
        )
        tween:Play()
        task.wait(segTime)
    end

    hrp.CFrame = CFrame.lookAt(destPos, targetRoot.Position)
end

-- ──────────────────────────────────────────────
-- HOOK METAMETHOD
-- ──────────────────────────────────────────────
local isProcessing = false
local oldNamecall

oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = { ... }

    if method == "FireServer" and self == targetRemote and CONFIG.Enabled then
        if not isProcessing then
            isProcessing = true
            
            task.spawn(function()
                for i = 1, CONFIG.ChainCount do
                    task.wait(CONFIG.FireDelay)
                    pcall(function()
                        targetRemote:FireServer(table.unpack(args))
                    end)
                end
                
                task.wait(CONFIG.FireDelay)
                isProcessing = false
            end)

            task.spawn(function()
                local target = findNearestTarget()
                if target and target:FindFirstChild("HumanoidRootPart") then
                    performCurvedDash(target.HumanoidRootPart)
                end
            end)
        end
    end

    return oldNamecall(self, ...)
end)

