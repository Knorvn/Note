-- CONFIG
-- ──────────────────────────────────────────────
local CONFIG = {
    Enabled = false,                 -- Bật / Tắt logic chính 💥
    EnableTrail = true,              -- Bật / Tắt hiệu ứng Trail 🌠
    AutoCancel = false,              -- Auto Cancel when 4x black flash ❌
    AutoM1Cancel = false,            -- Auto M1 when cancel 🥊
    BehindOffset = 5.5,              -- Distance 🎯
    MaxDistanceLimit = 40,           -- Giới hạn khoảng cách dash (XYZ) 📏
    AlreadyBehindTolerance = 3.5,
    FireDelay = 0.31,                -- Đã giảm delay xuống 0.31s ⏱️
    DashSpeed = 79,                  -- Speed 🚀
    ArcSegments = 5,
    SideWidth = 0.65,
    TrailLifetime = 0.35,
    DashAnimationId = "rbxassetid://0",
    TargetAnimId = "rbxassetid://123171106092050" -- Anim ID 4x Black Flash
}

